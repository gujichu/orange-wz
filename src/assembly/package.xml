<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.0 http://maven.apache.org/xsd/assembly-2.1.0.xsd">
    <id>bundle</id>
    <formats>
        <format>dir</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>
    <fileSets>
        <!-- 包含自动复制的JRE -->
        <fileSet>
            <directory>${project.build.directory}/jre</directory>
            <outputDirectory>/jre</outputDirectory>
        </fileSet>
        <!-- 包含主JAR -->
        <fileSet>
            <directory>${project.build.directory}</directory>
            <outputDirectory>/</outputDirectory>
            <includes>
                <include>${project.build.finalName}.jar</include>
            </includes>
            <excludes>
                <exclude>*-sources.jar</exclude>
                <exclude>*-javadoc.jar</exclude>
                <exclude>original-*.jar</exclude>
            </excludes>
        </fileSet>
        <!-- 包含依赖库 -->
        <fileSet>
            <directory>${project.build.directory}/lib</directory>
            <outputDirectory>/lib</outputDirectory>
        </fileSet>
        <!-- 包含必要的DLL和keys.dat -->
        <fileSet>
            <directory>${project.basedir}</directory>
            <outputDirectory>/</outputDirectory>
            <includes>
                <include>libcrypto-3-x64.dll</include>
                <include>keys.dat</include>
            </includes>
        </fileSet>
        <!-- 包含 tools 目录 -->
        <fileSet>
            <directory>${project.basedir}/tools</directory>
            <outputDirectory>/tools</outputDirectory>
            <includes>
                <include>ffmpeg.exe</include>
            </includes>
        </fileSet>
    </fileSets>
    <!-- 添加启动脚本 -->
    <files>
        <file>
            <source>${project.basedir}/OrzRepacker.bat</source>
            <outputDirectory>/</outputDirectory>
        </file>
    </files>
</assembly>